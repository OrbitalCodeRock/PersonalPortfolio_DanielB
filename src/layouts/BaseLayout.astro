---
import { ClientRouter } from 'astro:transitions';
import Starfield from '../components/Starfield.astro';
import { sections } from '../data/sections';
import '../styles/global.css';
import '../styles/secrets.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = 'Personal portfolio of Daniel Beyer: web development, game development, and machine learning.' } = Astro.props;
const fullTitle = title ? `${title} · Daniel Beyer` : 'Daniel Beyer';
const path = Astro.url.pathname;
// The Leaderboards tab is for the secret puzzle hunt: hidden until the visitor solves a secret (see the
// script below). It sits in alphabetical order with the rest.
const navLinks = [
	...sections.map((s) => ({ href: s.href, title: s.title, secret: false })),
	{ href: '/leaderboard', title: 'Leaderboards', secret: true },
].sort((a, b) => a.title.localeCompare(b.title));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
			rel="stylesheet"
		/>
		<title>{fullTitle}</title>
		<ClientRouter />
	</head>
	<body>
		<Starfield />
		<!-- Its own transition layer, so it stays above the live background layer (see global.css). -->
		<header class="site-header container" transition:name="site-header">
			<a class="logo" href="/">DB</a>
			<nav aria-label="Main">
				{
					navLinks.map((s) => (
						<a
							href={s.href}
							aria-current={path.startsWith(s.href) ? 'page' : undefined}
							class={s.secret ? 'nav-secret' : undefined}
							hidden={s.secret}
						>
							{s.title}
						</a>
					))
				}
			</nav>
		</header>
		<main class="container" transition:animate="slide">
			<slot />
		</main>
		<!-- Its own transition layer too, like the header. -->
		<footer class="site-footer container" transition:name="site-footer">
			<span>© 2026 Daniel Beyer</span>
			<a href="/credits" aria-current={path.startsWith('/credits') ? 'page' : undefined}>Credits</a>
			<!-- Shown only after the secret puzzle hunt is finished (src/secrets/finale.ts). -->
			<button type="button" class="secret-theme-toggle" aria-pressed="false" hidden>✦ Aurora</button>
		</footer>
	</body>
</html>

<script>
	import { initSecrets } from '../secrets/trigger';
	import { solvedCount, update } from '../secrets/progress';

	initSecrets();
	// The Leaderboards tab appears once a secret is solved, and right away when one is.
	const showSecretNav = () => {
		const show = solvedCount() > 0;
		document.querySelectorAll<HTMLElement>('.nav-secret').forEach((a) => (a.hidden = !show));
	};
	document.addEventListener('astro:page-load', showSecretNav);
	document.addEventListener('secrets:solved', showSecretNav);
	// The footer toggle for the theme unlocked by finishing the puzzle hunt.
	// A tap that some phones deliver twice would switch it straight back, so ignore repeats within 400 ms.
	let lastToggle = 0;
	document.addEventListener('click', (e) => {
		if (!(e.target as Element).closest?.('.secret-theme-toggle')) return;
		const now = performance.now();
		if (now - lastToggle < 400) return;
		lastToggle = now;
		update((p) => {
			p.theme = !p.theme;
		});
	});
</script>

<style>
	.site-header {
		display: flex;
		align-items: center;
		gap: 24px;
		padding-block: 20px;
	}
	.logo {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.3rem;
		color: var(--text);
		text-decoration: none;
		border: 1px solid var(--border-strong);
		border-radius: 10px;
		padding: 4px 10px;
	}
	nav {
		display: flex;
		gap: 4px 16px;
		flex-wrap: wrap;
		font-size: 0.9rem;
	}
	nav a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
	}
	nav a[hidden] {
		display: none;
	}
	main {
		padding-block: 32px 80px;
	}
	.site-footer {
		display: flex;
		gap: 8px 20px;
		flex-wrap: wrap;
		align-items: center;
		/* Extra room under the footer on phones, so its links aren't right at the screen's bottom edge, where
		   a tap tends to bring up the browser's toolbar instead of reaching the page. */
		padding-block: 0 max(28px, calc(env(safe-area-inset-bottom) + 28px));
		color: var(--text-muted);
		font-size: 0.8rem;
	}
	@media (pointer: coarse) {
		.site-footer {
			padding-bottom: max(64px, calc(env(safe-area-inset-bottom) + 48px));
		}
	}
	.site-footer a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}
	.site-footer a:hover,
	.site-footer a[aria-current='page'] {
		color: var(--text);
	}
	@media (max-width: 720px) {
		.site-header {
			align-items: flex-start;
		}
	}
</style>
