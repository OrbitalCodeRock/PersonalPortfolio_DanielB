---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	intro: string;
}

const { title, intro } = Astro.props;
---

<BaseLayout title={title}>
	<h1>{title}</h1>
	<p class="intro">{intro}</p>
	<slot />
	<div class="todo card">This page is still under construction.</div>
</BaseLayout>

<style>
	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		margin: 0 0 12px;
	}
	.intro {
		color: var(--text-muted);
		font-size: 1.1rem;
		max-width: 680px;
	}
	.todo {
		margin-top: 32px;
		padding: 18px 22px;
		color: var(--text-muted);
	}
</style>
