---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubGrid from '../../components/HubGrid.astro';
import { portfolios } from '../../data/sections';
---

<BaseLayout title="Portfolios">
	<h1>Portfolios</h1>
	<p class="intro">Three areas I work in. Choose one to dive in.</p>
	<HubGrid items={portfolios} />
</BaseLayout>

<style>
	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		margin: 0 0 12px;
	}
	.intro {
		color: var(--text-muted);
		font-size: 1.1rem;
		margin-bottom: 28px;
	}
</style>
