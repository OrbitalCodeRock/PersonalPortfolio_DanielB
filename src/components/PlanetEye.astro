---
// Faint hexagonal eye button that sits over the planet. cosmos.ts positions it
// each frame and toggles .is-hidden; extra attributes (data-*) pass through.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
	label: string;
}

const { label, ...attrs } = Astro.props;
---

<button class="eye-btn is-hidden" type="button" aria-label={label} {...attrs}>
	<svg viewBox="0 0 48 48" aria-hidden="true">
		<polygon class="hex" points="24,3 42,13.5 42,34.5 24,45 6,34.5 6,13.5"></polygon>
		<path class="eye" d="M12 24c3.5-5.5 7.5-8 12-8s8.5 2.5 12 8c-3.5 5.5-7.5 8-12 8s-8.5-2.5-12-8z"></path>
		<circle class="pupil" cx="24" cy="24" r="3.5"></circle>
	</svg>
</button>

<style>
	.eye-btn {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 5;
		width: 56px;
		height: 56px;
		padding: 0;
		border: 0;
		background: none;
		color: var(--accent);
		cursor: pointer;
		opacity: 0.5;
		transition: opacity 0.3s;
	}
	.eye-btn svg {
		width: 100%;
		height: 100%;
		overflow: visible;
		transition:
			transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
			filter 0.3s;
	}
	.hex {
		fill: rgba(111, 182, 255, 0.08);
		stroke: currentColor;
		stroke-width: 1.5;
	}
	.eye {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
	}
	.pupil {
		fill: currentColor;
	}
	.eye-btn:hover,
	.eye-btn:focus-visible {
		opacity: 1;
	}
	.eye-btn:hover svg,
	.eye-btn:focus-visible svg {
		transform: scale(1.2);
		filter: drop-shadow(0 0 10px rgba(111, 182, 255, 0.8));
	}
	.eye-btn:global(.is-hidden) {
		opacity: 0;
		pointer-events: none;
	}
</style>
