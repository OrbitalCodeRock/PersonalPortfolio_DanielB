---
// Plain text with one word turned into a secret trigger, for text that comes from a data array.
// Usage: <SecretText text="Built a simplicial complex tool" word="simplicial" id="timeline" />
import Secret from './Secret.astro';
import type { PuzzleId } from '../secrets/config';

interface Props {
	text: string;
	word?: string;
	id?: PuzzleId;
}

const { text, word, id } = Astro.props;
const at = word && id ? text.indexOf(word) : -1;
---

{
	at < 0 ? (
		text
	) : (
		<>
			{text.slice(0, at)}
			<Secret id={id!}>{word}</Secret>
			{text.slice(at + word!.length)}
		</>
	)
}
