---
// A secret trigger word: an ordinary-looking italic word that opens a puzzle when clicked
// (see src/secrets/trigger.ts). Usage: <Secret id="about">keyboard</Secret>
import type { PuzzleId } from '../secrets/config';

interface Props {
	id: PuzzleId;
}

const { id } = Astro.props;
---

<em class="secret-word" data-secret={id}><slot /></em>
