---
// Fixed Three.js background (see src/scripts/cosmos.ts).
// Persisted across page transitions so it never restarts.
---

<canvas id="starfield" aria-hidden="true" transition:persist></canvas>

<style>
	#starfield {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
	}
</style>

<script>
	import { initCosmos, reset } from '../scripts/cosmos';

	initCosmos(document.getElementById('starfield') as HTMLCanvasElement);
	// Leaving a page always returns the background to its default view.
	document.addEventListener('astro:before-swap', reset);
</script>
