---
// Home page overlay for the planet views in src/scripts/cosmos.ts:
// the eye button, planet cards, the star name tip, and controls.
import type { Section } from '../data/sections';
import PlanetEye from './PlanetEye.astro';

interface Props {
	items: Section[];
}

const { items } = Astro.props;
---

<div data-planet-explorer>
	<PlanetEye label="Explore the planet" data-eye />

	<div class="stage" data-stage inert>
		<div class="stage-bar">
			<button class="back-btn" type="button" data-back>
				<span aria-hidden="true">←</span>
				<span class="back-planet">Back to home</span>
				<span class="back-surface">Back to the planet</span>
			</button>
			<button
				class="back-btn locate-btn"
				type="button"
				aria-label="Show the sky from my location"
				title="Show the sky from my location"
				data-locate
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z"></path>
					<circle cx="12" cy="9.8" r="2.4"></circle>
				</svg>
			</button>
			<p class="hint hint-planet">Drag to spin the planet. Pick a card to land there.</p>
		</div>

		<div class="planet-cards" data-planet-cards>
			{
				items.map((s) => (
					<a class="planet-card" href={s.href} data-planet-card>
						<strong>{s.title}</strong>
						<span>{s.blurb}</span>
					</a>
				))
			}
		</div>

		<div class="star-tip" data-star-tip aria-hidden="true"></div>
		<div class="zoom-readout" data-zoom-readout aria-hidden="true"></div>

		<!-- Time controls for the sky view: run time faster, slower, backward, or pause. -->
		<div class="time-bar" role="group" aria-label="Sky time">
			<button class="time-btn" type="button" aria-label="Faster backward" title="Faster backward" data-time-back>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 6 3 12l8 6zM21 6l-8 6 8 6z"></path></svg>
			</button>
			<button class="time-btn" type="button" aria-label="Pause" title="Pause" data-time-pause>
				<svg viewBox="0 0 24 24" aria-hidden="true" data-icon-pause><path d="M7 5h3v14H7zM14 5h3v14h-3z"></path></svg>
				<svg viewBox="0 0 24 24" aria-hidden="true" data-icon-play hidden><path d="M8 5v14l11-7z"></path></svg>
			</button>
			<button class="time-btn" type="button" aria-label="Faster forward" title="Faster forward" data-time-forward>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 6l8 6-8 6zM3 6l8 6-8 6z"></path></svg>
			</button>
			<div class="time-readout" aria-live="off">
				<span class="time-date" data-time-date></span>
				<span class="time-speed" data-time-speed></span>
			</div>
			<button class="time-btn time-now" type="button" title="Back to the present" data-time-now>Now</button>
		</div>
	</div>
</div>

<style>
	.stage {
		position: fixed;
		inset: 0;
		z-index: 4;
		touch-action: none;
		cursor: grab;
		user-select: none;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.5s,
			visibility 0s 0.5s;
	}
	.stage:active {
		cursor: grabbing;
	}
	.stage.is-over-egg {
		cursor: pointer;
	}
	:global(body[data-view='planet']) .stage,
	:global(body[data-view='surface']) .stage {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.6s 0.6s;
	}

	.stage-bar {
		position: absolute;
		top: 20px;
		left: 16px;
		right: 16px;
		z-index: 200;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px 16px;
		pointer-events: none;
	}
	.back-btn {
		display: inline-flex;
		gap: 6px;
		pointer-events: auto;
		padding: 8px 16px;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		background: rgba(10, 16, 34, 0.8);
		color: var(--text);
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
		transition: border-color 0.2s;
	}
	.back-btn:hover {
		border-color: var(--accent);
	}
	.hint {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	.back-surface,
	.locate-btn,
	:global(body[data-view='surface']) .back-planet,
	:global(body[data-view='surface']) .hint-planet {
		display: none;
	}
	:global(body[data-view='surface']) .back-surface {
		display: inline;
	}
	:global(body[data-view='surface']) .locate-btn:not([hidden]) {
		display: inline-flex;
	}
	/* Round, icon-only button beside Back. */
	.locate-btn {
		width: 38px;
		height: 38px;
		padding: 0;
		align-items: center;
		justify-content: center;
	}
	.locate-btn svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	.locate-btn:disabled {
		opacity: 0.5;
		cursor: progress;
	}

	.planet-cards {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.5s;
	}
	:global(body[data-view='planet']) .planet-cards {
		opacity: 1;
	}

	/* While flying to a card, clear the UI out of the way. */
	.stage.is-traveling .stage-bar,
	.stage.is-traveling .planet-cards {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s;
	}

	.planet-card {
		position: absolute;
		left: 0;
		top: 0;
		width: 200px;
		padding: 10px 14px;
		display: flex;
		flex-direction: column;
		gap: 2px;
		background: rgba(10, 16, 34, 0.85);
		border: 1px solid var(--border-strong);
		border-radius: 12px;
		box-shadow: 0 8px 30px -10px rgba(0, 0, 0, 0.7);
		color: var(--text);
		text-decoration: none;
		transform-origin: bottom center;
		will-change: transform, opacity;
		transition: border-color 0.2s;
	}
	.planet-card:hover,
	.planet-card:focus-visible {
		border-color: var(--accent);
	}
	.planet-card strong {
		font-family: var(--font-display);
		font-size: 0.95rem;
	}
	.planet-card span {
		display: none;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.4;
	}
	.planet-card:global(.is-near) span {
		display: block;
	}

	/* Star name, shown above the star nearest the pointer (positioned by cosmos.ts). */
	.star-tip {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 201; /* above the stage bar, so it stays readable near the top */
		pointer-events: none;
		padding: 3px 10px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: rgba(5, 7, 15, 0.7);
		color: var(--text);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		white-space: nowrap;
		opacity: 0;
		transition: opacity 0.15s;
	}
	.star-tip:global(.is-visible) {
		opacity: 1;
	}

	/* Telescope magnification, bottom left, once zoomed in (text set by cosmos.ts). */
	.zoom-readout {
		position: absolute;
		left: 16px;
		bottom: 20px;
		z-index: 201;
		pointer-events: none;
		padding: 4px 10px;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: rgba(5, 7, 15, 0.7);
		color: var(--text-muted);
		font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		opacity: 0;
		transition: opacity 0.3s;
	}
	.zoom-readout:global(.is-visible) {
		opacity: 1;
	}

	/* Time controls, bottom center, in the sky view only. */
	.time-bar {
		position: absolute;
		left: 50%;
		bottom: 18px;
		z-index: 201;
		display: none;
		align-items: center;
		gap: 4px;
		padding: 5px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: rgba(5, 7, 15, 0.75);
		transform: translateX(-50%);
	}
	:global(body[data-view='surface']) .time-bar {
		display: flex;
	}
	.time-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 32px;
		height: 32px;
		padding: 0 8px;
		border: 1px solid transparent;
		border-radius: 999px;
		background: none;
		color: var(--text);
		font: inherit;
		font-size: 0.8rem;
		cursor: pointer;
		transition:
			border-color 0.2s,
			opacity 0.2s;
	}
	.time-btn:hover,
	.time-btn:focus-visible {
		border-color: var(--border-strong);
	}
	.time-btn:disabled {
		opacity: 0.35;
		cursor: default;
		border-color: transparent;
	}
	.time-btn svg {
		width: 15px;
		height: 15px;
		fill: currentColor;
	}
	.time-btn svg[hidden] {
		display: none; /* the hidden attribute alone doesn't hide SVG elements */
	}
	.time-readout {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 150px;
		padding: 0 8px;
		line-height: 1.2;
		pointer-events: none;
	}
	.time-date {
		color: var(--text);
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.time-speed {
		color: var(--text-muted);
		font-size: 0.7rem;
		white-space: nowrap;
	}
	/* Leave room for the magnification readout on narrow screens. */
	@media (max-width: 560px) {
		.time-bar {
			left: auto;
			right: 12px;
			transform: none;
		}
		.time-readout {
			min-width: 0;
		}
	}

	/* Planets and the Moon can be clicked to focus the telescope on them. */
	.stage:global(.is-over-body) {
		cursor: zoom-in;
	}
</style>

<script>
	import { navigate } from 'astro:transitions/client';
	import { changeSpeed, clockState, resetClock, skyNow, togglePause } from '../scripts/sky';
	import {
		bindHome,
		diveToCard,
		getSkyInfo,
		getView,
		isBusy,
		setView,
		useVisitorLocation,
		type View,
	} from '../scripts/cosmos';

	let pageAbort: AbortController | null = null;

	// Module scripts run once; rebind on every client-side navigation to the home page.
	document.addEventListener('astro:page-load', () => {
		pageAbort?.abort();
		const root = document.querySelector<HTMLElement>('[data-planet-explorer]');
		if (!root) return;
		pageAbort = new AbortController();
		const { signal } = pageAbort;

		const eye = root.querySelector<HTMLElement>('[data-eye]')!;
		const stage = root.querySelector<HTMLElement>('[data-stage]')!;
		const planetCards = root.querySelector<HTMLElement>('[data-planet-cards]')!;
		const starTip = root.querySelector<HTMLElement>('[data-star-tip]')!;
		const zoomReadout = root.querySelector<HTMLElement>('[data-zoom-readout]')!;
		const cards = [...root.querySelectorAll<HTMLElement>('[data-planet-card]')];

		const go = async (target: View) => {
			if (isBusy() || getView() === target) return;
			if (target !== 'orbit') window.scrollTo({ top: 0 });
			document.body.dataset.view = target;
			stage.inert = target === 'orbit';
			planetCards.inert = target !== 'planet';
			const arrived = setView(target);
			// The sky is chosen as soon as the landing starts.
			if (target === 'surface') updateLocate();
			await arrived;
			if (target !== 'orbit') root.querySelector<HTMLElement>('[data-back]')!.focus({ preventScroll: true });
		};

		// Location button: hidden once the sky already shows the visitor's location.
		const locate = root.querySelector<HTMLButtonElement>('[data-locate]')!;
		const updateLocate = () => {
			locate.hidden = getSkyInfo()?.place === 'your location';
		};
		locate.addEventListener(
			'click',
			async () => {
				locate.disabled = true;
				if (await useVisitorLocation()) updateLocate();
				locate.disabled = false;
			},
			{ signal },
		);
		const back = () => go(getView() === 'surface' ? 'planet' : 'orbit');

		// Fly to the clicked card, then load the page right where the camera ends up.
		// Modified clicks (new tab, etc.) keep their normal behavior.
		const travel = async (e: MouseEvent, fly: () => Promise<void>) => {
			if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			e.preventDefault();
			if (isBusy()) return;
			const { href } = e.currentTarget as HTMLAnchorElement;
			stage.classList.add('is-traveling');
			await fly();
			navigate(href);
		};
		cards.forEach((card, i) => card.addEventListener('click', (e) => travel(e, () => diveToCard(i)), { signal }));

		// Time controls: the sky view's clock lives in sky.ts; cosmos.ts reads it every frame.
		const timeDate = root.querySelector<HTMLElement>('[data-time-date]')!;
		const timeSpeed = root.querySelector<HTMLElement>('[data-time-speed]')!;
		const pauseButton = root.querySelector<HTMLButtonElement>('[data-time-pause]')!;
		const nowButton = root.querySelector<HTMLButtonElement>('[data-time-now]')!;
		const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
		const showTime = () => {
			const state = clockState();
			timeDate.textContent = dateFormat.format(skyNow());
			timeSpeed.textContent = state.paused ? 'Paused' : `${state.backward ? '◀' : '▶'} ${state.speed}`;
			pauseButton.querySelector('[data-icon-pause]')!.toggleAttribute('hidden', state.paused);
			pauseButton.querySelector('[data-icon-play]')!.toggleAttribute('hidden', !state.paused);
			pauseButton.setAttribute('aria-label', state.paused ? 'Play' : 'Pause');
			pauseButton.title = state.paused ? 'Play' : 'Pause';
			nowButton.disabled = state.live;
		};
		const timeActions: [string, () => void][] = [
			['[data-time-back]', () => changeSpeed(-1)],
			['[data-time-forward]', () => changeSpeed(1)],
			['[data-time-pause]', togglePause],
			['[data-time-now]', resetClock],
		];
		for (const [selector, action] of timeActions) {
			root.querySelector(selector)!.addEventListener(
				'click',
				() => {
					action();
					showTime();
				},
				{ signal },
			);
		}
		const timeTicker = setInterval(() => {
			if (getView() === 'surface') showTime();
		}, 250);
		signal.addEventListener('abort', () => clearInterval(timeTicker));
		showTime();

		bindHome({ eye, stage, cards, starTip, zoomReadout, onEgg: () => go('surface') });
		eye.addEventListener('click', () => go('planet'), { signal });
		root.querySelector('[data-back]')!.addEventListener('click', back, { signal });
		document.addEventListener(
			'keydown',
			(e) => {
				if (e.key === 'Escape' && getView() !== 'orbit') back();
			},
			{ signal },
		);
	});
</script>
