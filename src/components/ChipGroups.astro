---
// Labelled groups of chips: the skills page and the portfolio skill strips.
import SecretText from './SecretText.astro';
import type { PuzzleId } from '../secrets/config';

export interface ChipGroup {
	label: string;
	items: string[];
	/** Turns one word of the label into a secret trigger (see Secret.astro). */
	secret?: { word: string; id: PuzzleId };
}

interface Props {
	groups: ChipGroup[];
}

const { groups } = Astro.props;
---

<div class="chip-groups">
	{
		groups.map((g) => (
			<section class="chip-group card">
				<h3>
					<SecretText text={g.label} word={g.secret?.word} id={g.secret?.id} />
				</h3>
				<ul class="tags">
					{g.items.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</section>
		))
	}
</div>
